# JWT
# JWT_SECRET = your-secret-key-here

# ── IndexNow 즉시 색인 (이슈 #152) ──────────────────────────
# 콘텐츠 발행·수정 시 변경 URL 을 Bing·Naver·Yandex 등에 즉시 제출한다.
# 키는 32~64자 랜덤 16진 문자열 권장. /indexnow-key.txt 로 검증 파일이 서빙된다.
# 미설정 또는 로컬 도메인이면 제출하지 않는다(운영 도메인에서만 동작).
# INDEXNOW_KEY =
# INDEXNOW_TIMEOUT = 5   # 제출 호출 타임아웃(초)

# ── Bing Webmaster Tools 사이트 인증 (이슈 #160) ────────────────
# ChatGPT Search 는 Bing 색인에 의존 — Bing Webmaster Tools 사이트 등록 시 발급되는
# 인증 코드를 넣으면 /BingSiteAuth.xml 로 검증 파일이 서빙된다.
# BING_SITE_VERIFICATION =

#--------------------------------------------------------------------
# AI 일일 매출·소진 보고서 자동 생성 (이슈 #65)
#--------------------------------------------------------------------

# 공급자 선택 — 구현체: groq · gemini (다른 AI 추가 시 AiClientFactory에 등록)
# AI_PROVIDER = groq

# Groq — 일일 보고서(이슈 #65)에서 사용
# GROQ_API_KEY =
# GROQ_MODEL = llama-3.3-70b-versatile
# GROQ_TIMEOUT = 30   # 호출 타임아웃(초). 429·5xx는 지수 백오프로 자동 재시도

# Gemini — 의료광고 심의 사전검사(이슈 #71) 등 JSON 구조화 응답에서 사용
# GEMINI_API_KEY =
# GEMINI_MODEL = gemini-2.0-flash
# GEMINI_TIMEOUT = 30   # 호출 타임아웃(초). 429·5xx는 지수 백오프로 자동 재시도
